    }, 0);
    // Mount Batch Generation Panel below the button
    setTimeout(function() {
      if (window.BatchGenerationPanel) {
        var mount = document.getElementById('batch-generation-panel-mount');
        if (mount) {
          mount.innerHTML = '';
          var batchPanel = new window.BatchGenerationPanel();
          batchPanel.container.style.width = '100%';
          batchPanel.container.style.maxWidth = '100%';
          batchPanel.container.style.minWidth = '0';
          mount.appendChild(batchPanel.getElement());
        }
      }
    }, 0);
    // Render NFT grid (batch results) in the right column using batch data
    function renderBatchNftGrid() {
      var gridOuter = document.getElementById('batch-nft-grid-outer');
      if (!gridOuter) return;
      gridOuter.innerHTML = '';
      var batchPanel = window.BatchGenerationPanel && window.BatchGenerationPanel.instance;
      if (!batchPanel || !Array.isArray(batchPanel.nftBatch)) return;
      // Create grid container with consistent 10-column layout
      var grid = document.createElement('div');
      grid.className = 'batch-nft-grid';
      grid.id = 'nft-grid'; // Use consistent ID
      grid.style.display = 'grid';
      grid.style.gridTemplateColumns = 'repeat(10, 118px)'; // Consistent 10 columns
      grid.style.gap = '6px'; // Consistent gap
      grid.style.justifyContent = 'flex-start';
      grid.style.justifyItems = 'center';
      grid.style.width = '1250px'; // Consistent width
      grid.style.minWidth = '1250px';
      grid.style.height = '1214px'; // Fixed height for consistent layout
      grid.style.overflowY = 'auto';
      grid.style.padding = '8px';
      
      // Set up the outer container for consistent layout
      gridOuter.style.overflowX = 'auto';
      gridOuter.style.overflowY = 'hidden';
      gridOuter.style.width = '100%';
      gridOuter.style.minWidth = '1300px';
      gridOuter.style.maxWidth = '100%';
      gridOuter.style.display = 'flex';
      gridOuter.style.flexDirection = 'column';
      gridOuter.style.boxSizing = 'border-box';
      // Render NFT cards
      batchPanel.nftBatch.forEach((nft, i) => {
        const card = batchPanel.createNftCard(nft, i);
        grid.appendChild(card);
      });
      gridOuter.appendChild(grid);
      // --- Pagination controls for batch NFT grid ---
let pagination = gridOuter.parentNode.querySelector('#batch-nft-pagination');
if (!pagination) {
  pagination = document.createElement('div');
  pagination.id = 'batch-nft-pagination';
  pagination.style.display = 'flex';
  pagination.style.justifyContent = 'center';
  pagination.style.alignItems = 'center';
  pagination.style.gap = '8px';
  pagination.style.marginTop = '10px';
  gridOuter.parentNode.appendChild(pagination);
}
const cardsPerPage = 9 * 7;
const totalPages = Math.ceil(batchPanel.nftBatch.length / cardsPerPage);
if (typeof window.batchNftCurrentPage !== 'number') window.batchNftCurrentPage = 0;
let currentPage = window.batchNftCurrentPage;
function scrollToPage(pageIdx) {
  const scrollX = pageIdx * (130 + 5) * 9; // 9 cards + 8 gaps
  gridOuter.scrollTo({ left: scrollX, behavior: 'smooth' });
  window.batchNftCurrentPage = pageIdx;
  currentPage = pageIdx;
  updatePagination();
}
function updatePagination() {
  pagination.innerHTML = '';
  // '<<' button
  const firstBtn = document.createElement('button');
  firstBtn.textContent = '<<';
  firstBtn.disabled = currentPage === 0;
  firstBtn.onclick = () => scrollToPage(0);
  pagination.appendChild(firstBtn);
  // '<' button
  const prevBtn = document.createElement('button');
  prevBtn.textContent = '<';
  prevBtn.disabled = currentPage === 0;
  prevBtn.onclick = () => scrollToPage(Math.max(0, currentPage - 1));
  pagination.appendChild(prevBtn);
  // Page buttons (show up to 7, centered on current page)
  let startPage = Math.max(0, currentPage - 3);
  let endPage = Math.min(totalPages - 1, startPage + 6);
  if (endPage - startPage < 6) startPage = Math.max(0, endPage - 6);
  for (let i = startPage; i <= endPage; i++) {
    const pageBtn = document.createElement('button');
    pageBtn.textContent = (i + 1).toString();
    pageBtn.disabled = i === currentPage;
    pageBtn.onclick = () => scrollToPage(i);
    if (i === currentPage) pageBtn.style.background = '#6c5ce7';
    pagination.appendChild(pageBtn);
  }
  // '>' button
  const nextBtn = document.createElement('button');
  nextBtn.textContent = '>';
  nextBtn.disabled = currentPage === totalPages - 1;
  nextBtn.onclick = () => scrollToPage(Math.min(totalPages - 1, currentPage + 1));
  pagination.appendChild(nextBtn);
  // '>>' button
  const lastBtn = document.createElement('button');
  lastBtn.textContent = '>>';
  lastBtn.disabled = currentPage === totalPages - 1;
  lastBtn.onclick = () => scrollToPage(totalPages - 1);
  pagination.appendChild(lastBtn);
}
updatePagination();
setTimeout(() => scrollToPage(currentPage), 0);
    }
    // Hook into batch panel updates
    setTimeout(function() {
      if (window.BatchGenerationPanel && window.BatchGenerationPanel.instance) {
        var batchPanel = window.BatchGenerationPanel.instance;
        // Patch renderBatchPanels to also update the grid
        const origRender = batchPanel.renderBatchPanels.bind(batchPanel);
        batchPanel.renderBatchPanels = function() {
          origRender();
          renderBatchNftGrid();
        };
        // Initial render
        renderBatchNftGrid();
      }
    }, 100);

    this.projectData = projectData; // Store projectData for later use
    // Create a style element for dynamic CSS rules
    const styleElement = document.createElement("style");
    styleElement.textContent = `
      @media (max-width: 768px) {
        .generate-nfts-locked-group-row {
          flex-wrap: wrap;
      }
      .nft-preview-section {
          width: 100%;
        padding-left: 0;
      }
      .nft-preview-group {
        width: 100%;
        padding-left: 0;
      }
      .nft-preview-container {
        width: 100%;
        margin-top: 0;
      }
      .left-column-section {
        width: auto !important;
          max-width: 500px;
        min-width: 0;
        padding: 24px;
        padding-right: 8px !important;
      }
      .generate-nfts-locked-group {
        width: 100%;
      }
      /* Override left padding/margin for left column alignment */
