        height: 100% !important;
        max-height: none !important;
        min-height: 0 !important;
        overflow: auto !important;
        display: flex !important;
        flex-direction: column !important;
      }

      /* Ensure the traits list card is always visible */
      .traits-list-card {
        visibility: visible !important;
        opacity: 1 !important;
        display: flex !important;
      }

      /* Ensure traits info panel is always visible */
      .nft-trait-info-panel, .nft-trait-info-list {
        visibility: visible !important;
        opacity: 1 !important;
        display: flex !important;
      }
    `;
    document.head.appendChild(styleElement);

    console.log("Setting up UI for generate-nfts tab");
    // --- ENSURE THE GENERATE-NFTS TAB EXISTS AND IS VISIBLE ---
    let tabJustCreated = false;
    if (!generateNftsTab) {
      const contentArea = document.querySelector('.content-area');
      if (contentArea) {
        generateNftsTab = document.createElement('div');
        generateNftsTab.id = 'generate-nfts';
        generateNftsTab.className = 'tab-content';
        contentArea.appendChild(generateNftsTab);
        tabJustCreated = true;
      }
    }
    // --- ADD SECTION TITLE AND DESCRIPTION IF NOT PRESENT ---
    if (generateNftsTab && !generateNftsTab.querySelector('.section-title')) {
      const title = document.createElement('h2');
      title.className = 'section-title';
      title.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        Generate NFTs
      `;
      const desc = document.createElement('p');
      desc.className = 'section-description';
      desc.textContent = 'Create and preview NFT images for your collection.';
      generateNftsTab.insertBefore(desc, generateNftsTab.firstChild);
      generateNftsTab.insertBefore(title, desc);
    }
    // --- ALWAYS RENDER THE FOUR CONTROL ROWS IN A SINGLE PANEL ---
    if (generateNftsTab) {
      generateNftsTab.style.display = 'block';
      generateNftsTab.classList.add('active');
      // Add section title and description at the top, matching 'generate-metadata' tab
      generateNftsTab.innerHTML = `
        <h2 class="section-title">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          Generate NFTs
        </h2>
        <p class="section-description">Create and preview NFT images for your collection.</p>
        <div class="generate-nfts-main-row" style="display: flex; flex-direction: row; gap: 12px; align-items: flex-start; width: 100%;">
          <div class="nft-preview-panel" style="flex: 0 0 440px; max-width: 440px; min-width: 340px; display: flex; flex-direction: column; gap: 0;">
            <div class="nft-controls-panel" style="display: flex; flex-direction: column; gap: 0; width: 100%; background: #23232b; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.10); padding: 18px 18px 10px 18px; margin-bottom: 18px; border: 1.5px solid #29293a;">
              <div class="nft-collection-seed-row"></div>
              <div class="nft-rarity-seed-row"></div>
              <div class="nft-seedlist-random-row"></div>
              <div class="nft-seedinput-row"></div>
            </div>
            <div class="nft-preview-image-area"><div id="nft-preview-container"></div></div>
            <div id="display-full-seed-list-btn-mount"></div>
            <div id="batch-generation-panel-mount" style="width: 100%; max-width: 100%; margin-top: 18px;"></div>
          </div>
          <div class="traits-list-card" style="flex: 1 1 0; min-width: 320px; max-width: 320px; display: flex; flex-direction: column;">
            <div class="nft-trait-info-panel">
              <ul class="nft-trait-info-list"></ul>
            </div>
          </div>
          <div id="batch-nft-grid-outer" style="flex: 1 1 0; min-width: 400px; max-width: 1000px; display: flex; flex-direction: column; margin-left: 12px;"></div>
        </div>
      `;
      // Load Batch Generation Panel CSS if not already loaded
      if (!document.getElementById('batch-generation-panel-css')) {
        var batchCss = document.createElement('link');
        batchCss.rel = 'stylesheet';
        batchCss.type = 'text/css';
        batchCss.id = 'batch-generation-panel-css';
        batchCss.href = 'css/batch-generation-panel.css';
        document.head.appendChild(batchCss);
      }
      // Mount Batch Generation Panel
      setTimeout(function() {
        if (window.BatchGenerationPanel) {
          var mount = document.getElementById('batch-generation-panel-mount');
          if (mount) {
            mount.innerHTML = ''; // Clear previous panels
            var batchPanel = new window.BatchGenerationPanel();
            mount.appendChild(batchPanel.getElement());
          }
        }
      }, 0);
      // Always use an object for projectData to ensure controls render
      this._renderControlRows(projectData || {});
      // Always show the preview and traits panels
      const previewPanel = generateNftsTab.querySelector('.nft-preview-image-area');
      if (previewPanel) previewPanel.style.display = 'block';
      const traitPanel = generateNftsTab.querySelector('.nft-trait-info-panel');
      if (traitPanel) traitPanel.style.display = 'block';
    }

    // --- Render the collection seed row controls ---
    const collectionSeedRow = document.querySelector('.nft-collection-seed-row');
    if (collectionSeedRow) {
      collectionSeedRow.innerHTML = '';
      const rowFlex = document.createElement('div');
      rowFlex.style.display = 'flex';
      rowFlex.style.alignItems = 'center';
      rowFlex.style.margin = '0'; // Remove bottom margin for perfect stacking
      rowFlex.style.width = '100%';
      rowFlex.style.gap = '0';
      rowFlex.style.justifyContent = 'flex-end';
      // (Removed Unique NFTs toggle)
      // Collection seed toggle
      const collectionSeedToggleLabel = document.createElement('label');
      collectionSeedToggleLabel.style.display = 'flex';
      collectionSeedToggleLabel.style.alignItems = 'center';
      collectionSeedToggleLabel.style.gap = '6px';
      // Toggle button (styled switch)
      const toggleWrapper = document.createElement('span');
      toggleWrapper.style.display = 'inline-flex';
      toggleWrapper.style.alignItems = 'center';
      toggleWrapper.style.height = '24px';
      toggleWrapper.style.marginRight = '4px';
      toggleWrapper.style.position = 'relative';
      // Make the label clickable for the toggle and the text
      const collectionSeedToggle = document.createElement('input');
      collectionSeedToggle.type = 'checkbox';
      collectionSeedToggle.id = 'random-seed-toggle';
      collectionSeedToggle.style.opacity = '0';
      collectionSeedToggle.style.position = 'absolute';
      collectionSeedToggle.style.left = '0';
      collectionSeedToggle.style.top = '0';
      collectionSeedToggle.style.width = '36px';
      collectionSeedToggle.style.height = '20px';
      collectionSeedToggle.style.margin = '0';
      collectionSeedToggle.style.cursor = 'pointer';
      const toggleSlider = document.createElement('span');
      toggleSlider.style.width = '36px';
      toggleSlider.style.height = '20px';
      toggleSlider.style.background = '#444';
      toggleSlider.style.borderRadius = '12px';
      toggleSlider.style.position = 'relative';
      toggleSlider.style.transition = 'background 0.2s';
      toggleSlider.style.cursor = 'pointer';
      toggleSlider.style.display = 'inline-block';
      // Knob
      const toggleKnob = document.createElement('span');
      toggleKnob.style.position = 'absolute';
      toggleKnob.style.left = '2px';
      toggleKnob.style.top = '2px';
      toggleKnob.style.width = '16px';
      toggleKnob.style.height = '16px';
      toggleKnob.style.background = '#fff';
      toggleKnob.style.borderRadius = '50%';
      toggleKnob.style.transition = 'left 0.2s';
      toggleSlider.appendChild(toggleKnob);
      // Toggle checked state
      function updateToggleUI() {
        if (collectionSeedToggle.checked) {
          toggleSlider.style.background = '#6c5ce7';
          toggleKnob.style.left = '18px';
        } else {
          toggleSlider.style.background = '#444';
          toggleKnob.style.left = '2px';
        }
      }
      collectionSeedToggle.addEventListener('change', updateToggleUI);
      // Make the whole label clickable
      collectionSeedToggleLabel.style.cursor = 'pointer';
      // Initial state
      updateToggleUI();
      toggleWrapper.appendChild(collectionSeedToggle);
      toggleWrapper.appendChild(toggleSlider);
      collectionSeedToggleLabel.appendChild(toggleWrapper);
      const collectionSeedText = document.createElement('span');
      collectionSeedText.textContent = 'General Seed';
      collectionSeedText.className = 'seed-label';
      collectionSeedToggleLabel.appendChild(collectionSeedText);
      // Collection seed input
      const collectionSeedInput = document.createElement('input');
      collectionSeedInput.type = 'text';
      collectionSeedInput.id = 'random-seed';
      collectionSeedInput.placeholder = 'Seed for all NFTs';
      collectionSeedInput.style.flex = '1';
      collectionSeedInput.style.height = '28px';
      collectionSeedInput.style.fontSize = '13px';
      collectionSeedInput.style.marginLeft = '16px'; // Move 1 character to the right
      collectionSeedInput.style.borderRadius = '4px';
      collectionSeedInput.style.border = '1px solid #444';
      collectionSeedInput.style.background = '#181818';
      collectionSeedInput.style.color = '#fff';
      collectionSeedInput.style.textAlign = 'left';
      collectionSeedInput.disabled = true;
      // Order: toggle/label left, input right
      rowFlex.appendChild(collectionSeedToggleLabel);
      rowFlex.appendChild(collectionSeedInput);
      collectionSeedRow.appendChild(rowFlex);
      // Always enforce unique NFTs in projectData.settings
      if (projectData && projectData.settings) {
        projectData.settings.generateUniqueNfts = true;
      }
      // Restore state from projectData.settings if present
      const settings = (projectData && projectData.settings) ? projectData.settings : {};
      collectionSeedToggle.checked = !!settings.useRandomSeed;
      collectionSeedInput.value = '';
      collectionSeedInput.disabled = !collectionSeedToggle.checked;
      // Event listeners
      collectionSeedToggle.addEventListener('change', () => {
        collectionSeedInput.disabled = !collectionSeedToggle.checked;
        if (projectData && projectData.settings) {
          projectData.settings.useRandomSeed = collectionSeedToggle.checked;
          // When toggled off, clear the input field and projectData.settings.randomSeed
          if (!collectionSeedToggle.checked) {
            collectionSeedInput.value = '';
            projectData.settings.randomSeed = '';
          }
        }
      });
      collectionSeedInput.addEventListener('input', () => {
        if (projectData && projectData.settings) {
          if (collectionSeedToggle.checked) {
            projectData.settings.randomSeed = collectionSeedInput.value;
          }
        }
      });
    }

    // Ensure setupUI logic runs after DOM update so all control rows exist
    setTimeout(() => {
    // Setup event listeners
    if (window.NFTApp.getModule('generateNfts')) {
        // Use the stored projectData from the module, or fallback to window.currentProject
        const pd = (window.NFTApp.getModule('generateNftsUI') && window.NFTApp.getModule('generateNftsUI').projectData) || window.currentProject || null;
        window.NFTApp.getModule('generateNfts').setupEventListeners(pd);
    }
      // --- Custom logic for seed input tooltip and toggle ---
      // (all the rest of setupUI logic here)
      window.NFTApp.getModule('generateNftsUI')._renderControlRows(projectData);
    }, 0);
    return;
  },

